# --- LO QUE NUNCA DEBE VERSIONARSE ---------------------------------------
#
# Los tokens de los ocho nodos. Si se publicaran, cualquiera con acceso al
# repositorio podria inyectar datos en el dataset haciendose pasar por un nodo.
tokens.json
*.token

# Los datos. Una jornada son ~17 GB: ni caben ni tienen sentido en git.
datos/
/datos
medidas/

# Los pesos de los modelos. Son binarios grandes y versionados aparte, con su
# propio manifiesto y su propio hash.
modelos/pesos/*.bin
modelos/pesos/*.param
modelos/pesos/*.onnx
!modelos/pesos/manifiesto.ejemplo.json
# Lo mismo para la demo del modelo de tolva: la ficha (con su SHA-256) si va.
demo_tolva/modelos/*/*.bin
demo_tolva/modelos/*/*.param

# --- entorno -------------------------------------------------------------
.venv/
.venv-docs/
wheelhouse/
__pycache__/
*.py[cod]
*.egg-info/

# --- artefactos de compilacion del firmware ------------------------------
nodos/**/build/
nodos/**/*.bin
nodos/**/*.elf
nodos/**/.pio/

# --- sistema -------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
